diff --git a/build.bat b/build.bat
index 155c761..c75a1aa 100644
--- a/build.bat
+++ b/build.bat
@@ -1,8 +1,20 @@
 @echo off
-nasm src/mario.asm -f bin -o MARIO.COM
+setlocal
+pushd "%~dp0"
+
+where nasm >nul 2>nul
 if errorlevel 1 (
-    echo Build failed!
-    pause
+    echo Error: NASM was not found on PATH.
+    popd
     exit /b 1
 )
+
+nasm -f bin -o MARIO.COM src\mario.asm
+if errorlevel 1 (
+    echo Build failed!
+    popd
+    exit /b 1
+)
 echo Build successful: MARIO.COM created.
+popd
+endlocal
diff --git a/src/gfx.asm b/src/gfx.asm
index 0c4d9de..b7f0c3a 100644
--- a/src/gfx.asm
+++ b/src/gfx.asm
@@ -53,6 +53,7 @@ fillrect:
     push bx
     push cx
     push dx
+    push si
     push di
 
     mov es, [buf_seg]
@@ -73,13 +74,20 @@ fillrect:
     shl di, 8
     add di, ax
     add di, [bp+12]
 
+    mov si, [bp+12]         ; current x coordinate, for horizontal clipping
     mov cx, [bp+8]          ; w
     mov al, [bp+4]          ; col
 .col:
     cmp cx, 0
     jle .next_row
+    cmp si, 0
+    jl .skip_px
+    cmp si, 320
+    jge .skip_px
     mov [es:di], al
+.skip_px:
     inc di
+    inc si
     dec cx
     jmp .col
@@ -90,6 +98,7 @@ fillrect:
 
 .done:
     pop di
+    pop si
     pop dx
     pop cx
     pop bx
@@ -259,6 +267,5 @@ drawmap:
     ; pick tile color
     mov cl, COL_BROWN
-    cmp al, -320            ; dummy
     mov dl, [level_map + si]
     cmp dl, TILE_GROUND
     je .t_ground
